# HealthMate AI - Backend Environment Configuration Example
APP_NAME="HealthMate AI"
APP_VERSION="1.0.0"

# Database Configuration (SQLite by default; supports PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/healthmate)
DATABASE_URL="sqlite:///./healthmate.db"

# JWT Authentication Secrets (Generate a secure 32+ character random string for production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-before-deployment
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend CORS Origin (e.g. https://your-healthmate-frontend.vercel.app)
FRONTEND_URL="http://localhost:5173"

# Upload Directory & Limits (For Render persistent disk, set to /var/data/uploads)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=15

# Centralized AI Gateway Configuration
# Supported providers: openrouter, gemini, openai, local
AI_PROVIDER="openrouter"
AI_API_KEY="your-openrouter-api-key-here"
AI_MODEL="google/gemini-2.5-flash"
AI_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct"
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MAX_TOKENS=800
AI_HISTORY_LIMIT=10
